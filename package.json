{
  "name": "dsh-plugin-deep-scan",
  "version": "0.1.0",
  "description": "dsh plugin: iterative GitHub deep search — multi-query × 4-channel search (phrase / loose / README full-text / topic sweep), mine new query terms from hit topics, iterate rounds with a diminishing-returns stop rule, and rank by channel precision + stars.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "category": "扫描与研究",
      "blurb": "GitHub 赛道深度扫描器：多词四通道搜索 + 自动挖 topic 迭代，止损规则内置",
      "entries": "`/deep-scan` `deep_scan`"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "github",
    "search",
    "discovery",
    "competitive-analysis",
    "niche",
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/121212165/dsh-plugin-deep-scan.git"
  },
  "sideEffects": false,
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-base": "^0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.4",
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "bugs": {
    "url": "https://github.com/121212165/dsh-plugin-deep-scan/issues"
  },
  "icon": "./icon.svg",
  "dependencies": {
    "@dsh-family/kit": "github:121212165/dsh-plugin-kit#v0.2.1"
  }
}
